      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "from_layer": {
      "enum": [
        "bronze_b0",
        "bronze_b1",
        "bronze_b2",
        "silver",
        "gold",
        "platinum"
      ],
      "title": "From Layer",
      "type": "string"
    },
    "to_layer": {
      "enum": [
        "bronze_b0",
        "bronze_b1",
        "bronze_b2",
        "silver",
        "gold",
        "platinum"
      ],
      "title": "To Layer",
      "type": "string"
    },
    "input_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
