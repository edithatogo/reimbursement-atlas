      },
      "minItems": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "required_gate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Gate Ids",
      "type": "array"
    },
    "passed_gate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
