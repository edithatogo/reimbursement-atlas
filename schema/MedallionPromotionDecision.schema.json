      "type": "string"
    },
    "decided_at": {
      "minLength": 1,
      "title": "Decided At",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "scope_notes": {
      "minLength": 1,
      "title": "Scope Notes",
      "type": "string"
    }
