{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OsfPostRegistrationEvolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reviewer",
    "reviewed_at",
    "registered_snapshot_sha256",
    "current_protocol_digest",
    "current_analysis_manifest_digest",
    "current_source_cutoff",
    "disclosure",
    "excluded_representations",
    "approval_reference"
  ],
  "properties": {
    "schema_version": {"const": "osf-post-registration-evolution-v1"},
    "status": {"const": "approved_as_post_registration_evolution"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "registered_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_analysis_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_source_cutoff": {"type": "string", "minLength": 1},
    "disclosure": {"type": "string", "minLength": 1},
    "excluded_representations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approval_reference": {"type": "string", "minLength": 1}
  }
}
